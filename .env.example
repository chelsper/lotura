# Runtime source. Local development defaults to demo when this is omitted.
# Preview and Production default to neon.
LOTURA_EXPLORER_MODE="demo"

# Needed for self-hosted environment classification. Vercel uses VERCEL_ENV.
LOTURA_RUNTIME_ENV="development"

# Required only for neon and neon-with-demo-fallback modes.
LOTURA_ORGANIZATION_ID=""

# Production requires this separate opt-in before fallback mode is accepted.
LOTURA_ALLOW_DEMO_FALLBACK="false"

# Pooled Neon connection for application queries from Next.js and Vercel.
# Production and deployed runtime use should supply a dedicated read-only role.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Direct owner/migration connection for explicit schema and seed commands only.
# The application never substitutes this value when DATABASE_URL is missing.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
