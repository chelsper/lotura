# Pooled Neon connection for application queries from Next.js and Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Direct Neon connection for Drizzle Kit migrations and schema tooling.
